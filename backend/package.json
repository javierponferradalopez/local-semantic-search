{
  "name": "backend",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "bootstrap": "cp -n .env.example .env; pnpm run db:up && pnpm run db:migrate",
    "dev": "tsx watch src/api/main.ts",
    "db:up": "docker compose up -d --wait",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "contract": "workspace:*",
    "dotenv": "17.2.4",
    "drizzle-orm": "0.45.3",
    "express": "5.2.1",
    "pg": "8.17.0"
  },
  "devDependencies": {
    "@types/express": "5.0.6",
    "@types/node": "24.10.1",
    "drizzle-kit": "0.31.11",
    "tsx": "4.23.15",
    "typescript": "7.0.2"
  }
}
